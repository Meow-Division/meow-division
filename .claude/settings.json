{
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(git * push *)",
      "Bash(cargo near deploy*)",
      "Bash(near contract deploy*)",
      "Bash(near tokens * send-near*)",
      "Bash(near tokens * send-ft*)",
      "Bash(near account delete-account*)",
      "Bash(near account add-key*)",
      "Bash(near account delete-keys*)",
      "Bash(gh repo edit * --visibility*)",
      "Bash(gh repo create * --public*)",
      "Bash(curl * nearhackathon.com/api/applications*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./server/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.mjs"],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
