# Copy to .env for local development. The game runs in guest mode with none of these set.
# Values live only in .env (gitignored) and in the server's systemd EnvironmentFile. Never in git, logs or chat.

# Server
PORT=8930
DATA_DIR=./data
TRUST_PROXY=0
PUBLIC_ORIGIN=http://localhost:8930
# (no session secret here: the session and device tokens are signed with DATA_DIR/secret, 32 random bytes the server
# writes on its first start)

# NEAR (mainnet; empty = chain features off, the game still runs)
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org
NEAR_RPC_FALLBACK_URL=https://free.rpc.fastnear.com
NEAR_GAME_ACCOUNT=meowdivision.near
NEAR_ITEMS_CONTRACT=items.meowdivision.near
NEAR_WALT_ACCOUNT=walt.meowdivision.near
NEAR_SIGNER_ACCOUNT=
NEAR_SIGNER_KEY=
NEAR_WALT_KEY=
# the players' market (server/market.mjs): its treasury's key (a full-access key of an implicit account that holds only
# the money in transit; scripts/market-key.sh makes it on the server); empty = the market shows lots but takes none
MARKET_KEY=
MARKET_ACCOUNT=
# NEAR Intents 1Click (partners.near-intents.org): a partner key lowers its fee; empty works too
ONECLICK_API_KEY=
ONECLICK_BASE=https://1click.chaindefuser.com
# wallets made in the game (server/wallets.mjs): a day's cap in all and from one address
WALLET_DAILY_CAP=20
WALLET_IP_DAILY_CAP=3

# NEAR AI Cloud (server/nearai.mjs: Walt's words at his counter and the market watch; empty = the plain texts)
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# tokens a day in all (about $0.1 a day at the default)
NEAR_AI_DAILY_TOKENS=300000
# the market watch's language (server/watch.mjs, its lines in the server's log)
WATCH_LANG=Russian

# NEAR Intents 1Click (skin shop; empty = shop hidden)
INTENTS_1CLICK_JWT=

# Telegram bot (only on the server)
TELEGRAM_BOT_TOKEN=

# ElevenLabs (gen/voice.mjs, the voice lines; .env.local, made by `npx -y @elevenlabs/cli@latest onboard init`)
ELEVENLABS_API_KEY=
